# ============================================================
#   TORTOSA — Configuración del servidor (Apache)
#   Sustituye al .htaccess de la web antigua (WordPress).
# ============================================================

# La web nueva manda aunque quede algún index.php de la antigua
DirectoryIndex index.html

# Página para direcciones que no existen (cuenta atrás y a la portada)
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Dirección única: https://comercialtortosa.com (sin www), en un solo salto
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # URLs de la web antigua (sacadas de su wp-sitemap.xml) → páginas nuevas
  RewriteRule ^politica-privacidad/?$ /privacidad.html [R=301,L]
  RewriteRule ^aviso-legal/?$ /aviso-legal.html [R=301,L]
  RewriteRule ^politica-de-cookies/?$ /cookies.html [R=301,L]
  RewriteRule ^imprenta/?$ /trabajos.html#imprenta [R=301,L,NE]
  RewriteRule ^rotulacion/?$ /trabajos.html#rotulacion [R=301,L,NE]
  RewriteRule ^project/regalos-de-empresa-1/?$ /trabajos.html#regalos-empresa [R=301,L,NE]
  RewriteRule ^project/ /trabajos.html [R=301,L]
  RewriteRule ^project_category/catalogos/?$ /#catalogos [R=301,L,NE]
  RewriteRule ^project_category/ /trabajos.html [R=301,L]
  RewriteRule ^blog(/.*)?$ / [R=301,L]
  RewriteRule ^wp-sitemap.*\.xml$ /sitemap.xml [R=301,L]
</IfModule>
